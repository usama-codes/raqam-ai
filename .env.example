# ─── Convex ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── AI Model Provider (OpenAI Agents SDK + Gemini backend) ────────────────
# The OpenAI Agents SDK is used for agent orchestration, but the underlying
# LLM is Google Gemini via its OpenAI-compatible API endpoint.
# IMPORTANT: This key must be set in the Convex deployment environment
# (Convex Dashboard → Settings → Environment Variables, or via CLI):
#   npx convex env set GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
# Convex actions run server-side and read env vars from the deployment, not .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Vision / OCR (Phase 11) ────────────────────────────────────────────────
GOOGLE_CLOUD_VISION_API_KEY=

# ─── Speech-to-Text (AssemblyAI — primary transcription engine, Phase 11) ────
# Voice input transcribes in this order:
#   AssemblyAI  →  Gemini  →  browser Web Speech API
# AssemblyAI model: "universal-2" — the cheapest AssemblyAI tier and the only
# AssemblyAI model that supports Urdu. Language is auto-detected per recording.
#
# Set this in the CONVEX DEPLOYMENT environment (server-side), NOT in .env.local —
# Convex actions read their own deployment env:
#   npx convex env set ASSEMBLYAI_API_KEY=your-key-here
# Create a key: https://www.assemblyai.com/dashboard/api-keys
# If unset, transcription falls back to Gemini, then the browser's Web Speech API.
ASSEMBLYAI_API_KEY=

# ─── Twilio SMS (proactive Urdu budget alerts) ───────────────────────────────
# Sends the opt-in Urdu budget/bill/monthly-summary alerts (convex/notifications.ts).
# Get these from https://console.twilio.com:
#   - TWILIO_ACCOUNT_SID: Account Info → Account SID (starts with "AC").
#   - TWILIO_AUTH_TOKEN:  Account Info → Auth Token.
#   - TWILIO_FROM_NUMBER: an SMS-enabled Twilio number in E.164, e.g.
#     "+14155550123" (Messaging → Senders → Phone Numbers). Trial accounts can
#     only send to verified numbers — verify your own number first under
#     Phone Numbers → Manage → Verified Caller IDs.
#
# Set these in the CONVEX DEPLOYMENT environment (server-side), NOT .env.local —
# Convex actions read their own deployment env:
#   npx convex env set TWILIO_ACCOUNT_SID=your-account-sid
#   npx convex env set TWILIO_AUTH_TOKEN=your-auth-token
#   npx convex env set TWILIO_FROM_NUMBER=+14155550123
# If unset, sends fail gracefully (logged "failed" in notificationLog) — nothing
# crashes, and users simply receive no messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Text-to-Speech (Gemini TTS — Urdu voice replies in voice-call mode) ────
# Optional overrides for the TTS chain (convex/ai.ts → lib/ai/tts.ts).
# Defaults when empty:
#   model chain: gemini-3.1-flash-tts-preview → gemini-2.5-flash-preview-tts
#                → gemini-2.5-pro-preview-tts
#   voice:       "Kore" (warm, works well for Urdu; other prebuilt voices:
#                Aoede, Puck, Charon, Fenrir, etc.)
#
# Set these in the CONVEX DEPLOYMENT environment (server-side), NOT .env.local:
#   npx convex env set GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
#   npx convex env set GEMINI_TTS_VOICE=Aoede
# Reuses GOOGLE_GENERATIVE_AI_API_KEY (above) for auth. If synthesis fails, the
# browser's speechSynthesis (ur-PK) fallback takes over automatically.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
